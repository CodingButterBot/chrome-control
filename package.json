{
  "name": "mcp-chrome-control",
  "version": "1.5.2",
  "description": "Browser automation for AI assistants - Chrome control via JSON-RPC and MCP",
  "main": "bin/index.js",
  "type": "module",
  "bin": {
    "mcp-chrome-control": "bin/chrome-mcp.js"
  },
  "exports": {
    ".": "./bin/index.js",
    "./client": "./bin/client.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node bin/index.js",
    "dev": "tsc -w & nodemon bin/index.js",
    "lint": "eslint src --ext .ts",
    "setup-hooks": "git config core.hooksPath .githooks && chmod +x .githooks/*",
    "mcp:run": "node scripts/run-mcp-call.js --file toolcalls.json",
    "mcp:add": "node scripts/run-mcp-call.js --add",
    "test:navigate": "node tests/navigation.test.js",
    "test:zod": "node tests/zod-convert.test.js",
    "test:unit": "node tests/unit/run-all-tests.js",
    "test:unit:browser": "node tests/unit/browser-management.test.js",
    "test:unit:tab": "node tests/unit/tab-management.test.js",
    "test:unit:nav": "node tests/unit/navigation.test.js",
    "test:simple": "node tests/units/simple-browser-test.js",
    "test:nav": "node tests/units/navigation-test.js",
    "test:form": "node tests/units/form-interaction-test.js",
    "test:screenshot": "node tests/units/screenshot-eval-test.js",
    "test:units": "node tests/units/run-tests.js",
    "test:units:sequential": "npm run test:simple && npm run test:nav && npm run test:form && npm run test:screenshot",
    "test:comprehensive": "node tests/comprehensive-test.js",
    "test:mcp": "node tests/mcp-protocol-test.js",
    "test:full-features": "node tests/mcp-full-feature-test.js",
    "test:llm-simulation": "node tests/llm-simulation-test.js",
    "test:mock-llm": "node tests/mock-llm-test.js",
    "test:basic-llm": "node tests/basic-llm-sim.js",
    "test:tools": "mocha --require ts-node/register src/tools/**/*.__TEST__.ts",
    "test": "npm run test:zod && npm run test:basic-llm",
    "test:all": "npm run test:zod && npm run test:basic-llm",
    "precommit": "npm run build && npm run test:all",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:serve": "npm run docs && npx serve docs/api",
    "postinstall": "npm run build",
    "prepare": "npm run build && npm run setup-hooks",
    "publish:npm": "npm run build && npm run docs && npm publish"
  },
  "keywords": [
    "mcp",
    "chrome",
    "puppeteer",
    "browser",
    "automation",
    "model",
    "context",
    "protocol",
    "ai",
    "assistant",
    "json-rpc",
    "webautomation",
    "scraping",
    "testing"
  ],
  "author": "codingbutter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codingbutter/chrome-control.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@types/chai": "^5.2.1",
    "@types/mocha": "^10.0.10",
    "chai": "^5.2.0",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.7.2",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-anonymize-ua": "^2.4.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "mocha": "^11.2.2",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.3",
    "typedoc-plugin-markdown": "^4.6.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ]
}
