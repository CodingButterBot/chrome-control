{
  "name": "mcp-chrome-control",
  "version": "1.1.0",
  "description": "Browser automation for AI assistants - Chrome control via JSON-RPC and MCP",
  "main": "bin/index.js",
  "type": "module",
  "bin": "./bin/chrome-mcp.js",
  "exports": {
    ".": "./bin/index.js",
    "./client": "./bin/client.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node bin/index.js",
    "dev": "tsc -w & nodemon bin/index.js",
    "lint": "eslint src --ext .ts",
    "test": "npm run test:browser",
    "test:browser": "node tests/test-browser.js",
    "test:mcp": "node tests/test-mcp.js",
    "test:enhanced": "node tests/test-mcp-enhanced.js",
    "test:navigation": "node tests/test-enhanced-navigation.js",
    "test:filtering": "node tests/test-dom-filtering.js",
    "test:chaining": "node tests/test-action-chaining.js",
    "test:multi-navigation": "node tests/test-multi-navigation.js",
    "test:interactions": "node tests/test-interactions.js",
    "test:advanced-filtering": "node tests/test-advanced-filtering.js",
    "test:advanced-chaining": "node tests/test-advanced-chaining.js",
    "test:all": "npm run test:browser && npm run test:mcp && npm run test:enhanced && npm run test:navigation && npm run test:filtering && npm run test:chaining && npm run test:multi-navigation && npm run test:interactions && npm run test:advanced-filtering && npm run test:advanced-chaining && npm run test:google-image",
    "test:google-image": "node tests/test-google-image-search.js",
    "example:puppies": "node tests/examples/duckduckgo-puppies.js",
    "postinstall": "npm run build",
    "prepare": "npm run build",
    "publish:npm": "npm run build && npm publish"
  },
  "keywords": [
    "mcp",
    "chrome",
    "puppeteer",
    "browser",
    "automation",
    "model",
    "context",
    "protocol",
    "ai",
    "assistant",
    "json-rpc",
    "webautomation",
    "scraping",
    "testing"
  ],
  "author": "codingbutter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codingbutter/chrome-control.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.7.2",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-anonymize-ua": "^2.4.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ]
}
