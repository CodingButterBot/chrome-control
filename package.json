{
  "name": "mcp-chrome-control",
  "version": "1.0.1",
  "description": "Chrome Control MCP server for Model Context Protocol",
  "main": "bin/index.js",
  "type": "module",
  "bin": "./bin/chrome-mcp.js",
  "scripts": {
    "build": "tsc",
    "start": "node bin/index.js",
    "dev": "tsc -w & nodemon bin/index.js",
    "lint": "eslint src --ext .ts",
    "test": "npm run test:browser",
    "test:browser": "node test-browser.js",
    "test:mcp": "node test-mcp.js",
    "test:enhanced": "node test-mcp-enhanced.js",
    "test:navigation": "node test-enhanced-navigation.js",
    "example:puppies": "node duckduckgo-puppies.js",
    "postinstall": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "chrome",
    "puppeteer",
    "browser",
    "automation",
    "model",
    "context",
    "protocol"
  ],
  "author": "codingbutter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codingbutter/chrome-control.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.7.2",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-anonymize-ua": "^2.4.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ]
}
