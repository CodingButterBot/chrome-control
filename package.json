{
  "name": "mcp-chrome-control",
  "version": "1.3.0",
  "description": "Browser automation for AI assistants - Chrome control via JSON-RPC and MCP",
  "main": "bin/index.js",
  "type": "module",
  "bin": {
    "mcp-chrome-control": "bin/chrome-mcp.js"
  },
  "exports": {
    ".": "./bin/index.js",
    "./client": "./bin/client.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node bin/index.js",
    "start:direct": "node bin/direct-index.js",
    "start:simple": "node bin/simple-index.js",
    "dev": "tsc -w & nodemon bin/index.js",
    "dev:direct": "tsc -w & nodemon bin/direct-index.js",
    "dev:simple": "tsc -w & nodemon bin/simple-index.js",
    "lint": "eslint src --ext .ts",
    "mcp:run": "node scripts/run-mcp-call.js --file toolcalls.json",
    "mcp:add": "node scripts/run-mcp-call.js --add",
    "postinstall": "npm run build",
    "prepare": "npm run build",
    "publish:npm": "npm run build && npm publish"
  },
  "keywords": [
    "mcp",
    "chrome",
    "puppeteer",
    "browser",
    "automation",
    "model",
    "context",
    "protocol",
    "ai",
    "assistant",
    "json-rpc",
    "webautomation",
    "scraping",
    "testing"
  ],
  "author": "codingbutter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codingbutter/chrome-control.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.7.2",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-anonymize-ua": "^2.4.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ]
}
